<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Example only. Do not install: calibration and live-use gates remain blocked.
     latest selects the latest completed UTC hour in the explicitly supplied
     detached copy. The operator must provide a new detached copy to advance.
     Repeated runs are idempotent; no clock, live database or network is used. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.danslab.grid-radar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/python3</string>
    <string>-m</string><string>trader.research.kucoin_cli</string>
    <string>operator</string>
    <string>--snapshot</string><string>/ABSOLUTE/OFFLINE/COPY/market.sqlite3</string>
    <string>--asof</string><string>latest</string>
    <string>--running</string><string>/ABSOLUTE/OFFLINE/INPUT/running.json</string>
    <string>--output</string><string>/ABSOLUTE/NEW/OFFLINE/OUTPUT</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/GrokBot-grid-kucoin</string>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
