<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template only. Review absolute paths and create log directories before use.
     Each invocation collects for 24 hours under a per-database flock; launchd
     restarts the next bounded session. Stop the hand-started updater first.
     The 24-hour CLI and this template must not run against the same DB together.
     No credentials, CoinGlass requests, account requests, or exchange orders. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danslab.trader-market-data</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-m</string>
        <string>trader.data.updater</string>
        <string>--database</string>
        <string>/Users/davidai/Sandbox/grokbot/market-data/phase-2-20260911/market.sqlite3</string>
        <string>--duration-hours</string>
        <string>24</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/davidai/ZCodeProject/GrokBot</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>StandardOutPath</key>
    <string>/Users/davidai/Sandbox/grokbot/market-data/logs/updater.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/davidai/Sandbox/grokbot/market-data/logs/updater.err.log</string>
</dict>
</plist>
