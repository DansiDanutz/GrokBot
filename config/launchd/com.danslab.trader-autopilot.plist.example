<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.danslab.trader-autopilot</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>scripts/credential-exec.py</string>
		<string>--credentials</string>
		<string>/Users/davidai/.config/danslab/credentials/telegram.json</string>
		<string>--</string>
		<string>/opt/homebrew/bin/python3</string>
		<string>-m</string>
		<string>trader.autopilot</string>
		<string>run</string>
		<string>--database</string>
		<string>/Users/davidai/Sandbox/grokbot/market-data/phase-2-20260911/market.sqlite3</string>
		<string>--state</string>
		<string>/Users/davidai/Sandbox/grokbot/autopilot/state.json</string>
		<string>--radar</string>
		<string>/Users/davidai/Sandbox/grokbot/radar/radar.json</string>
		<string>--snapshot</string>
		<string>/Users/davidai/Sandbox/grokbot/autopilot/autopilot.json</string>
		<string>--telegram-chat-id</string>
		<string>REPLACE_WITH_DAN_CHAT_ID</string>
		<string>--telegram-state</string>
		<string>/Users/davidai/Sandbox/grokbot/autopilot/telegram-state.json</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/davidai/ZCodeProject/GrokBot</string>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/davidai/Sandbox/grokbot/autopilot/autopilot.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/davidai/Sandbox/grokbot/autopilot/autopilot.stderr.log</string>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
