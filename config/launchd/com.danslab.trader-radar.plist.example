<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.danslab.trader-radar</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string><string>-m</string><string>trader.radar</string>
    <string>--database</string><string>/Users/davidai/Sandbox/grokbot/market-data/phase-2-20260911/market.sqlite3</string>
    <string>--json</string><string>/Users/davidai/Sandbox/grokbot/radar/radar.json</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/davidai/ZCodeProject/GrokBot</string>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>5</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/davidai/Sandbox/grokbot/radar/radar.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/davidai/Sandbox/grokbot/radar/radar.stderr.log</string>
